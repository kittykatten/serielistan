rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ÄNDRA HÄR: era två e-postadresser (med små bokstäver)
    function isMember() {
      return request.auth != null
        && request.auth.token.email.lower() in ['kittykatten@gmail.com', 'jerry.thorsen@gmail.com'];
    }

    // Serier som ni delar (Our stuff)
    match /shows/{showId} {
      allow read, write: if isMember();
    }

    match /users/{userId} {
      allow read: if isMember();
      allow write: if isMember() && request.auth.uid == userId;

      // Egna listor (My stuff): bara personen själv kan se dem
      match /movies/{movieId} {
        allow read, write: if isMember() && request.auth.uid == userId;
      }
      match /shows/{showId} {
        allow read, write: if isMember() && request.auth.uid == userId;
      }
    }

    // Filmer som ni delar (Our stuff)
    match /sharedMovies/{movieId} {
      allow read, write: if isMember();
    }

    // Gemensamma inställningar (streamingtjänster)
    match /settings/{settingId} {
      allow read, write: if isMember();
    }
  }
}
